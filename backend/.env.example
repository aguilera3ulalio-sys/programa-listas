# Neon PostgreSQL connection string. Never commit the real value.
DATABASE_URL=postgresql://user:password@host.neon.tech/dbname?sslmode=require

# Port the server listens on (hosting platforms set this automatically).
PORT=3001

# Comma-separated list of origins allowed to call this API.
# In production set this to your deployed frontend URL.
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# --- Recuperacion de NIP por correo (opcional) ---
# Sin esto, la app sigue funcionando: el codigo se escribe en el log del servidor
# en vez de enviarse, y la opcion "recuperar por correo" no aparece en el login.
# Consigue una API key gratis en https://resend.com
RESEND_API_KEY=
# Remitente. Con la cuenta gratis de Resend puedes usar onboarding@resend.dev
# para pruebas; para produccion necesitas verificar un dominio propio.
MAIL_FROM=UAQ Docentes <onboarding@resend.dev>
